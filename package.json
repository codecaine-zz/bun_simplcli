{
  "name": "bun-simplcli",
  "version": "1.3.0",
  "description": "Comprehensive zero-dependency headless console & RAD toolkit for Bun with rich UI, telemetry, redis, and 54 CLI tools",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "simplcli": "./bin/simplcli.ts",
    "bun-simplcli": "./bin/simplcli.ts"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "cli_apps",
    "README.md",
    "CLI_API.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "start": "bun run bin/simplcli.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "setup:brew": "bash ./scripts/install_dependencies.sh",
    "setup:brew:all": "bash ./scripts/install_dependencies.sh --all",
    "check:deps": "bash ./scripts/install_dependencies.sh --check",
    "prepublishOnly": "bun test && bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codecaine-zz/bun_simplcli.git"
  },
  "keywords": [
    "bun",
    "cli",
    "terminal",
    "console",
    "rad",
    "redis",
    "namespaced-redis",
    "prompts",
    "tables",
    "spinners",
    "sparklines",
    "telemetry",
    "zero-dependencies"
  ],
  "author": "codecaine",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest"
  }
}
